{
  "manifest_version": 3,
  "default_locale": "es",
  "name": "__MSG_extensionName__",
  "version": "1.0.22",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "scripts/service-worker.js"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.edu.xunta.gal/grade/grading/form/rubric/edit.php*",
        "https://www.edu.xunta.gal/*/grade/grading/form/rubric/edit.php*",
        "https://edu.xunta.gal/grade/grading/form/rubric/edit.php*",
        "https://edu.xunta.gal/*/grade/grading/form/rubric/edit.php*",
        "https://centros.edu.xunta.gal/grade/grading/form/rubric/edit.php*",
        "https://centros.edu.xunta.gal/*/grade/grading/form/rubric/edit.php*",
        "https://platega.edu.xunta.gal/grade/grading/form/rubric/edit.php*",
        "https://platega.edu.xunta.gal/*/grade/grading/form/rubric/edit.php*",
        "https://eva.edu.xunta.gal/grade/grading/form/rubric/edit.php*",
        "https://eva.edu.xunta.gal/*/grade/grading/form/rubric/edit.php*"
      ],
      "css": [
        "styles/main.css",
        "styles/toast.css",
        "styles/dropzone.css"
      ],
      "js": [
        "scripts/workbook.js",
        "scripts/i18n.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_locales/*/messages.json"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
